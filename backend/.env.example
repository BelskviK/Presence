# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Supabase Postgres, via the Supavisor connection pooler)
# Find these under Project Settings -> Database -> Connection string -> Connection pooling
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_DB_NAME=postgres

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRY=30d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug

# Email (for notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password
SMTP_FROM=noreply@attendance-mgmt.com

# Geofence Settings
DEFAULT_GEOFENCE_RADIUS=500
GPS_REQUIRED=true

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
